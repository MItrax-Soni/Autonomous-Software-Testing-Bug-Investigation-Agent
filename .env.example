# ==============================================================================
# AUTONOMOUS SOFTWARE TESTING & BUG INVESTIGATION AGENT - ENVIRONMENT CONFIG
# ==============================================================================
# Copy this file to .env and configure the values before starting services.
# Do NOT commit sensitive keys (like GEMINI_API_KEY) to version control.

# --- AI Intelligence (Google Gemini) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Backend API Service ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database Persistence ---
# SQLite with async support (default)
DATABASE_URL=sqlite+aiosqlite:///./test_agent.db
# PostgreSQL alternative example:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/test_agent_db

# --- Browser Automation (Playwright) ---
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_DEFAULT_TIMEOUT_MS=30000
PLAYWRIGHT_ACTION_TIMEOUT_MS=5000
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=800

# --- Security & SSRF Protection ---
SSRF_PROTECTION_ENABLED=true
# Allow testing against the internal controlled defective app running on port 8088
SSRF_ALLOW_CONTROLLED_LOCAL_APP=true
CONTROLLED_LOCAL_APP_PORT=8088

# --- Evidence & Artifacts ---
ARTIFACTS_DIR=./artifacts

# --- Frontend Application ---
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
